# Copy to .env and fill in. NEVER commit .env. Values requested at Phase 15.
# See docs/architecture/02-low-level-architecture.md §5.2

# --- MikroTik hAP lite RouterOS API ---
MIKROTIK_HOST="10.10.10.1"
MIKROTIK_PORT=8728
MIKROTIK_USERNAME="vendo"
MIKROTIK_PASSWORD="Welcome01"
MIKROTIK_USE_SSL=false

# Hotspot user profile that already exists in your MikroTik (do not create/overwrite).
MIKROTIK_HOTSPOT_PROFILE=default

# Must match captive-portal/assets/js/config.js loginOption:
#   false <-> loginOption 1 (hotspot user password = voucher)   [current setup]
#   true  <-> loginOption 0 (empty password)
MIKROTIK_USERNAME_ONLY=false


